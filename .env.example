# ── Required ──────────────────────────────────────────────────────────────────
# Your Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# AWS credentials (for Lambda invocation)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Telegram (bot token + your chat/user ID)
TELEGRAM_BOT_TOKEN=<bot_token from @BotFather>
TELEGRAM_CHAT_ID=<your numeric chat ID>

# ── Optional: override data source ────────────────────────────────────────────
# By default the agent fetches S&P 500 changes from Wikipedia.
# You can point it at a local CSV instead (see data/sp500_changes.csv.example).
# SPX_CHANGES_CSV=data/sp500_changes.csv
